# Telegram application credentials from https://my.telegram.org/apps
TG_API_ID=
TG_API_HASH=

# Optional external SOCKS5 proxy for Telegram (MTProto and BotFather; login and worker).
# TG_PROXY=socks5://proxy.example.com:1080
# With authentication: socks5://user:password@proxy.example.com:1080
# Percent-encode special characters in credentials; use $$ for a literal $ in Compose.
TG_PROXY=

# Published HTTP address: Caddy by default, web with compose.external-proxy.yaml.
# External reverse proxy on the host: forward to http://127.0.0.1:8080.
WEB_HOST=127.0.0.1
WEB_PORT=8080
# Caddy only (unused with compose.external-proxy.yaml):
WEB_HTTPS_PORT=8443
CADDY_SITE_ADDRESS=:80

# Public HTTPS: point DNS at the server and set all four values:
# WEB_HOST=0.0.0.0
# WEB_PORT=80
# WEB_HTTPS_PORT=443
# CADDY_SITE_ADDRESS=names.example.com

# Backend: mtproto (default) or botfather (import private/botfather.json first).
CHECK_BACKEND=mtproto

# Request spacing for either backend (CHECK_DELAY must be >= 3 seconds)
CHECK_DELAY=3
CHECK_JITTER=0.5

# Continuous oldest-first queue. 0 = next cycle immediately.
RECHECK_HOURS=0
# Hide availability results older than this from the default view.
CACHE_HOURS=72
# Retry connection / fatal API errors after this many seconds.
RETRY_DELAY=300
